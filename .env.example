# Copie este archivo a .env y complete SUS valores. NUNCA suba .env al repositorio.

# --- Escenario (mismos valores = mismos datos y mismo caso) ---
CASO_ID=C-07
SEMILLA=4213

# --- IA: "azure" (producción / demo con Azure OpenAI) o "mock" (pruebas sin red ni costo) ---
PROVEEDOR_IA=azure
# Endpoint y clave del recurso de Azure OpenAI en Microsoft Foundry (portal: proyecto > Claves y punto de conexión).
# Sirve tanto https://<recurso>.openai.azure.com/ como https://<recurso>.cognitiveservices.azure.com/ (sin /openai/v1 ni rutas extra).
AZURE_OPENAI_ENDPOINT=https://<su-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<clave-de-azure-openai>
AZURE_OPENAI_API_VERSION=2024-10-21
# Nombres de los DEPLOYMENTS creados en Azure AI Foundry (no el nombre del modelo)
# (gpt-5-mini es de razonamiento: se usa max_completion_tokens y no se envía temperature)
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_ROUTER=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_STT=whisper
AZURE_OPENAI_DEPLOYMENT_TTS=tts
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-small
TTS_VOZ=alloy
# Tarifas de referencia de gpt-5-mini para estimar costo (USD por 1000 tokens); verifique el precio vigente en su suscripción
PRECIO_USD_1K_TOKENS_IN=0.00025
PRECIO_USD_1K_TOKENS_OUT=0.002

# --- Azure SQL (datos de negocio + checkpointer de LangGraph) ---
AZURE_SQL_SERVER=<servidor>.database.windows.net
AZURE_SQL_DATABASE=reclamos
# Esquema propio del proyecto: TODAS las tablas (negocio, tickets, checkpoints) viven aquí, no en dbo.
# Vacío = esquema por defecto del usuario (no recomendado si la base se comparte con otros proyectos).
AZURE_SQL_SCHEMA=multimodal
AZURE_SQL_USER=<usuario>
AZURE_SQL_PASSWORD=<contraseña>
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
# 1 = autenticación de Windows (solo SQL Server/LocalDB local)
AZURE_SQL_TRUSTED=0

# --- Qdrant Cloud: URL del cluster y API key; URL vacía = modo local en .qdrant_local (un solo proceso) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLECCION=politicas_reclamacion

# --- Observabilidad: vacío = solo archivos en evidencia/ ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Operación ---
MCP_TRANSPORT=stdio
HITL_TIMEOUT_HORAS=24
MAX_UPLOAD_MB=5
OPERADOR_EMAIL=operador@ejemplo.test
SMTP_HOST=
SMTP_PORT=1025
# 1 = la API devuelve el OTP y el detalle de errores (SOLO demostración local)
DEMO_MODE=0
ANALISTA_API_KEY=cambiar-esta-clave
